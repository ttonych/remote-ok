#include <windows.h>
#include "build_version.h"
1 RT_MANIFEST "src/app.manifest"
1 VERSIONINFO
FILEVERSION G60S_VERSION_NUM
PRODUCTVERSION G60S_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "G60S OK remote helper"
      VALUE "FileVersion", G60S_VERSION_TEXT
      VALUE "ProductName", "G60S OK"
      VALUE "ProductVersion", G60S_VERSION_TEXT
      VALUE "OriginalFilename", "G60S-OK.exe"
      VALUE "LegalCopyright", "G60S OK contributors. MIT license."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
